{
  "name": "hyze-leads-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc",
    "test": "vitest run",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hyze-leads --local",
    "db:migrate:remote": "wrangler d1 migrations apply hyze-leads --remote",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:local": "wrangler d1 migrations apply hyze-leads --local && wrangler dev"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  },
  "description": "API de leads dos sites Hyze (api.hyzecompany.com.br) — Hono + D1 + Turnstile",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
